# Supabase project that receives contact form submissions.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Absolute origin of the production site, without a trailing slash, e.g.
# https://leibinn-consulting.de
# Substituted into index.html for canonical + Open Graph URLs. Leaving it
# empty makes those URLs root-relative, which most crawlers still resolve,
# but set it before launch.
VITE_SITE_URL=
