# Set these in the Vercel project (Settings → Environment Variables). All optional.

# Central lead service (forms and consent log), e.g. https://leads.leibinn-consulting.de
VITE_LEADS_API_URL=

# Ad tracking, loaded only after consent. Empty = not loaded.
VITE_META_PIXEL_ID=
VITE_LINKEDIN_PARTNER_ID=
VITE_LINKEDIN_CONVERSION_LEAD=
VITE_LINKEDIN_CONVERSION_BOOKING=

# Overrides the shared 60-minute Calendly event
VITE_CALENDLY_URL=
